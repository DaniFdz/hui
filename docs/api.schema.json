{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActivityBlock": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "firstMessage": {
          "type": "string"
        }
      }
    },
    "ActivitySession": {
      "type": "object",
      "required": [
        "id",
        "title",
        "group",
        "project",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityBlock"
          }
        }
      }
    },
    "ApiSchemaDocument": {
      "type": "object",
      "required": [
        "$schema",
        "$defs",
        "x-hui-api-version",
        "x-hui-areas",
        "x-hui-routes"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "$defs": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "x-hui-api-version": {
          "type": "string"
        },
        "x-hui-areas": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "x-hui-routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiSchemaRoute"
          }
        }
      }
    },
    "ApiSchemaError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "ApiSchemaReference": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string"
        }
      }
    },
    "ApiSchemaRoute": {
      "type": "object",
      "required": [
        "method",
        "path",
        "response"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ApiSchemaReference"
        },
        "response": {
          "$ref": "#/$defs/ApiSchemaReference"
        },
        "events": {
          "$ref": "#/$defs/ApiSchemaReference"
        }
      }
    },
    "BrowserSettings": {
      "type": "object",
      "required": [
        "enabled",
        "headless",
        "executablePath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "headless": {
          "type": "boolean"
        },
        "executablePath": {
          "type": "string"
        }
      }
    },
    "DatadogConnection": {
      "type": "object",
      "required": [
        "cli",
        "orgs",
        "pupOrgs",
        "login"
      ],
      "properties": {
        "cli": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "installed"
              ],
              "properties": {
                "installed": {
                  "type": "boolean",
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "required": [
                "installed",
                "version"
              ],
              "properties": {
                "installed": {
                  "type": "boolean",
                  "const": true
                },
                "version": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "orgs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatadogOrgStatus"
          }
        },
        "pupOrgs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatadogOrg"
          }
        },
        "login": {
          "$ref": "#/$defs/DatadogLoginState"
        }
      }
    },
    "DatadogError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "DatadogLoginState": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "phase",
            "org",
            "expiresAt"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "pending"
            },
            "org": {
              "$ref": "#/$defs/DatadogOrg"
            },
            "url": {
              "type": "string"
            },
            "expiresAt": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "phase",
            "org",
            "message"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "failed"
            },
            "org": {
              "$ref": "#/$defs/DatadogOrg"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "DatadogOrg": {
      "type": "object",
      "required": [
        "name",
        "site"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      }
    },
    "DatadogOrgRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      }
    },
    "DatadogOrgStatus": {
      "type": "object",
      "required": [
        "name",
        "site",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "connected"
            },
            {
              "type": "string",
              "const": "signed_out"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        }
      }
    },
    "DatadogPreview": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "title"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "share"
            },
            {
              "type": "string",
              "const": "widget"
            },
            {
              "type": "string",
              "const": "dashboard"
            }
          ]
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "relative": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "DatadogPreviewError": {
      "anyOf": [
        {
          "type": "string",
          "const": "not_found"
        },
        {
          "type": "string",
          "const": "signed_out"
        },
        {
          "type": "string",
          "const": "no_org"
        },
        {
          "type": "string",
          "const": "cli_missing"
        },
        {
          "type": "string",
          "const": "unavailable"
        }
      ]
    },
    "DatadogPreviewResult": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/DatadogPreview"
        },
        "error": {
          "$ref": "#/$defs/DatadogPreviewError"
        },
        "signIn": {
          "$ref": "#/$defs/DatadogOrg"
        }
      }
    },
    "DatadogPreviewsResponse": {
      "type": "object",
      "required": [
        "previews"
      ],
      "properties": {
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatadogPreviewResult"
          }
        }
      }
    },
    "GitHubAccount": {
      "type": "object",
      "required": [
        "host",
        "login",
        "scopes"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokenSource": {
          "type": "string"
        }
      }
    },
    "GitHubConnection": {
      "type": "object",
      "required": [
        "cli",
        "status",
        "login"
      ],
      "properties": {
        "cli": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "installed"
              ],
              "properties": {
                "installed": {
                  "type": "boolean",
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "required": [
                "installed",
                "version"
              ],
              "properties": {
                "installed": {
                  "type": "boolean",
                  "const": true
                },
                "version": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "connected"
            },
            {
              "type": "string",
              "const": "disconnected"
            },
            {
              "type": "string",
              "const": "invalid"
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "account": {
          "$ref": "#/$defs/GitHubAccount"
        },
        "message": {
          "type": "string"
        },
        "login": {
          "$ref": "#/$defs/GitHubLoginState"
        }
      }
    },
    "GitHubContributionAccount": {
      "type": "object",
      "required": [
        "login",
        "commits",
        "pullRequests"
      ],
      "properties": {
        "login": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      }
    },
    "GitHubContributions": {
      "type": "object",
      "required": [
        "accounts"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitHubContributionAccount"
          }
        }
      }
    },
    "GitHubError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "GitHubLoginState": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "starting"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "phase",
            "userCode",
            "verificationUri",
            "expiresAt"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "pending"
            },
            "userCode": {
              "type": "string"
            },
            "verificationUri": {
              "type": "string"
            },
            "expiresAt": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "phase",
            "message"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "GitHubPreview": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "url",
            "fullName",
            "stars",
            "forks",
            "private",
            "archived"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "repo"
            },
            "url": {
              "type": "string"
            },
            "fullName": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "stars": {
              "type": "number"
            },
            "forks": {
              "type": "number"
            },
            "language": {
              "type": "string"
            },
            "private": {
              "type": "boolean"
            },
            "archived": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "url",
            "repository",
            "number",
            "title",
            "state",
            "additions",
            "deletions",
            "changedFiles",
            "comments"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "pull"
            },
            "url": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "number": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/PullRequestState"
            },
            "author": {
              "type": "string"
            },
            "additions": {
              "type": "number"
            },
            "deletions": {
              "type": "number"
            },
            "changedFiles": {
              "type": "number"
            },
            "comments": {
              "type": "number"
            },
            "body": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "url",
            "repository",
            "number",
            "title",
            "state",
            "comments",
            "labels"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "issue"
            },
            "url": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "number": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "open"
                },
                {
                  "type": "string",
                  "const": "closed"
                }
              ]
            },
            "stateReason": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "comments": {
              "type": "number"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "body": {
              "type": "string"
            }
          }
        }
      ]
    },
    "GitHubPreviewError": {
      "anyOf": [
        {
          "type": "string",
          "const": "not_found"
        },
        {
          "type": "string",
          "const": "signed_out"
        },
        {
          "type": "string",
          "const": "cli_missing"
        },
        {
          "type": "string",
          "const": "unavailable"
        }
      ]
    },
    "GitHubPreviewResult": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/GitHubPreview"
        },
        "error": {
          "$ref": "#/$defs/GitHubPreviewError"
        }
      }
    },
    "GitHubPreviewsResponse": {
      "type": "object",
      "required": [
        "previews"
      ],
      "properties": {
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitHubPreviewResult"
          }
        }
      }
    },
    "JiraConnection": {
      "type": "object",
      "required": [
        "configured",
        "site",
        "email",
        "tokenSet",
        "defaultProject"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "site": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "tokenSet": {
          "type": "boolean"
        },
        "defaultProject": {
          "type": "string"
        },
        "accountName": {
          "type": "string"
        }
      }
    },
    "JiraConnectRequest": {
      "type": "object",
      "required": [
        "site",
        "email",
        "token",
        "defaultProject"
      ],
      "properties": {
        "site": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "defaultProject": {
          "type": "string"
        }
      }
    },
    "JiraCreateRequest": {
      "type": "object",
      "required": [
        "project",
        "parent",
        "summary",
        "description"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "assignToMe": {
          "type": "boolean"
        },
        "suggestionId": {
          "type": "string"
        }
      }
    },
    "JiraCreateResponse": {
      "type": "object",
      "required": [
        "issue"
      ],
      "properties": {
        "issue": {
          "$ref": "#/$defs/JiraIssueRef"
        },
        "session": {},
        "warning": {
          "type": "string"
        }
      }
    },
    "JiraDefaultProjectRequest": {
      "type": "object",
      "required": [
        "defaultProject"
      ],
      "properties": {
        "defaultProject": {
          "type": "string"
        }
      }
    },
    "JiraDraft": {
      "type": "object",
      "required": [
        "project",
        "parents",
        "parent",
        "summary",
        "description"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JiraParentCandidate"
          }
        },
        "parent": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "parentChoice": {
          "anyOf": [
            {
              "type": "string",
              "const": "suggested"
            },
            {
              "type": "string",
              "const": "unmatched"
            },
            {
              "type": "string",
              "const": "none-available"
            },
            {
              "type": "string",
              "const": "not-drafted"
            },
            {
              "type": "string",
              "const": "omitted"
            }
          ]
        },
        "rejectedParent": {
          "type": "string"
        }
      }
    },
    "JiraDraftRequest": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "suggestionId": {
          "type": "string"
        }
      }
    },
    "JiraDraftResponse": {
      "type": "object",
      "required": [
        "draft"
      ],
      "properties": {
        "draft": {
          "$ref": "#/$defs/JiraDraft"
        }
      }
    },
    "JiraError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "JiraIssueMatch": {
      "type": "object",
      "required": [
        "key",
        "url",
        "summary"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "statusCategory": {
          "$ref": "#/$defs/JiraStatusCategory"
        },
        "issueType": {
          "type": "string"
        }
      }
    },
    "JiraIssueRef": {
      "type": "object",
      "required": [
        "key",
        "url"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "JiraIssuesResponse": {
      "type": "object",
      "required": [
        "issues"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JiraIssueMatch"
          }
        }
      }
    },
    "JiraLinkRequest": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        }
      }
    },
    "JiraLinkResponse": {
      "type": "object",
      "required": [
        "issue"
      ],
      "properties": {
        "issue": {
          "$ref": "#/$defs/JiraIssueRef"
        },
        "session": {}
      }
    },
    "JiraParentCandidate": {
      "type": "object",
      "required": [
        "key",
        "summary",
        "issueType",
        "hierarchyLevel"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "issueType": {
          "type": "string"
        },
        "hierarchyLevel": {
          "type": "number"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "JiraProject": {
      "type": "object",
      "required": [
        "key",
        "name"
      ],
