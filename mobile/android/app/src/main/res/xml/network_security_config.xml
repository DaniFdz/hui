<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only where the app's own tests reach a gateway: loopback on the device, and `10.0.2.2`, which is the host
     machine from the emulator. Every other gateway needs https, the supported setup (docs/mobile-app-plan.md, owner
     decision O3). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
